{
	"name": "ops-center",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "tsx scripts/dev.ts",
		"dev:db": "docker compose up -d",
		"dev:db:stop": "docker compose down",
		"dev:db:reset": "docker compose down -v && docker compose up -d",
		"build": "tsc -b && vite build",
		"lint": "eslint .",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:policy": "bin/opa test policies/",
		"build:policies": "tsx scripts/build-policies.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx database/migrate.ts",
		"db:seed": "tsx database/seed.ts",
		"db:seed-superadmin": "tsx database/seed-superadmin.ts",
		"db:studio": "drizzle-kit studio",
		"simulate": "tsx scripts/matchday-simulator.ts",
		"verify:deploy": "tsx scripts/verify-deploy.ts",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{ts,tsx}": [
			"eslint --fix",
			"bash -c 'tsc -b'"
		]
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/commands": "^6.10.4",
		"@codemirror/language": "^6.12.4",
		"@codemirror/legacy-modes": "^6.5.3",
		"@codemirror/lint": "^6.9.7",
		"@codemirror/state": "^6.7.1",
		"@codemirror/theme-one-dark": "^6.1.3",
		"@codemirror/view": "^6.43.6",
		"@heroui/react": "^3.2.2",
		"@heroui/styles": "^3.2.2",
		"@hookform/resolvers": "^3.10.0",
		"@netlify/vite-plugin-react-router": "^4.0.0",
		"@open-policy-agent/opa-wasm": "^1.10.0",
		"@react-router/node": "^8.2.0",
		"@react-router/serve": "^8.2.0",
		"@tailwindcss/vite": "^4.3.2",
		"@uiw/react-codemirror": "^4.25.11",
		"dotenv": "^17.4.2",
		"driver.js": "^1.7.0",
		"drizzle-orm": "^0.45.2",
		"i18next": "^26.3.6",
		"idb": "^8.0.3",
		"isbot": "^5.2.1",
		"jose": "^6.2.3",
		"leaflet": "^1.9.4",
		"pg": "^8.22.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-error-boundary": "^6.1.2",
		"react-hook-form": "^7.55.0",
		"react-i18next": "^17.0.9",
		"react-leaflet": "^5.0.0",
		"react-router": "^8.2.0",
		"zod": "^3.24.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@react-router/dev": "^8.2.0",
		"@types/leaflet": "^1.9.21",
		"@types/node": "^24.13.3",
		"@types/pg": "^8.20.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.3",
		"drizzle-kit": "^0.31.0",
		"eslint": "^10.6.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.3",
		"globals": "^17.7.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.8",
		"tailwindcss": "^4.3.2",
		"tsx": "^4.23.1",
		"typescript": "~6.0.2",
		"typescript-eslint": "^8.62.0",
		"vite": "^8.1.1",
		"vite-plugin-mkcert": "^2.1.0",
		"vite-plugin-pwa": "^1.3.0",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^4.1.10"
	}
}

{
	"name": "ops-center",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "tsx scripts/dev.ts",
		"dev:db": "docker compose up -d",
		"dev:db:stop": "docker compose down",
		"dev:db:reset": "docker compose down -v && docker compose up -d",
		"build": "tsc -b && vite build",
		"lint": "eslint .",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"db:migrate": "tsx database/migrate.ts",
		"simulate": "tsx scripts/matchday-simulator.ts",
		"verify:deploy": "tsx scripts/verify-deploy.ts"
	},
	"dependencies": {
		"@heroui/react": "^3.2.2",
		"@heroui/styles": "^3.2.2",
		"@netlify/vite-plugin-react-router": "^4.0.0",
		"@react-router/node": "^8.2.0",
		"@react-router/serve": "^8.2.0",
		"@tailwindcss/vite": "^4.3.2",
		"dotenv": "^17.4.2",
		"i18next": "^26.3.6",
		"idb": "^8.0.3",
		"isbot": "^5.2.1",
		"jose": "^6.2.3",
		"pg": "^8.22.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-i18next": "^17.0.9",
		"react-router": "^8.2.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@react-router/dev": "^8.2.0",
		"@types/node": "^24.13.2",
		"@types/pg": "^8.20.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.3",
		"eslint": "^10.6.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.3",
		"globals": "^17.7.0",
		"tailwindcss": "^4.3.2",
		"tsx": "^4.23.1",
		"typescript": "~6.0.2",
		"typescript-eslint": "^8.62.0",
		"vite": "^8.1.1",
		"vite-plugin-pwa": "^1.3.0",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^4.1.10"
	}

# ─────────────────────────────────────────────────────────────────────────────
# Stadium Ops Grid Matrix — Environment Variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# See docs/DEPLOYMENT-RUNBOOK.md §Phase 3 for production setup.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Netlify Postgres — ADR-0002) ───────────────────────────────────
# Connection string for the managed Postgres instance.
DATABASE_URL=postgres://user:password@host:5432/stadium_ops?sslmode=require

# ── Netlify Blobs (Audit Chain store — ADR-0005) ─────────────────────────────
# Token for the Blobs store used by the append-only audit ledger.
NETLIFY_BLOBS_TOKEN=

# ── Auth: RS256 JWT keys (ADR-0003) ───────────────────────────────────────────
# Generate with:
#   openssl genrsa -out jwt-private.pem 2048
#   openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
# Paste the PEM contents (including BEGIN/END lines) as single values.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Token expiry in seconds (default: 3600 = 1 hour)
JWT_EXPIRES_IN=3600

# ── Twilio (OTP via raw SMS — ADR-0003) ───────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
# OTP security: code expiry (seconds) and max verification attempts
OTP_EXPIRES_IN=300
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60

# ── OpenAI Whisper (voice transcription — ADR-0006) ───────────────────────────
OPENAI_API_KEY=

# ── Google Gemini (structured extraction — ADR-0006) ──────────────────────────
GEMINI_API_KEY=

# ── App / Build ───────────────────────────────────────────────────────────────
APP_PORT=5173
BASE_URL=/
# Comma-separated list of allowed CORS origins (strict — do NOT use * in prod)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8888
